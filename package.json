{
  "name": "Attendance-system-refine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev-refine": "refine dev",
    "dev": "vite dev",
    "dev:web": "vite dev --mode web",
    "tsc-check": "tsc --noEmit",
    "dev-profile": "vite dev --profile --open",
    "build": "vite build && node copy_electron_files.js",
    "build-log": "powershell -Command \"$date = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'; mkdir -Force logs; function Strip-ANSI { $input -replace '\\e\\[[0-9;]*m', '' }; npx tsc --noEmit 2>&1 | Strip-ANSI | Tee-Object -FilePath logs/build-$date.log; if ($LASTEXITCODE -eq 0) { npx vite build 2>&1 | Strip-ANSI | Tee-Object -FilePath logs/build-$date.log -Append } else { Write-Error 'TypeScript compilation failed' }\"",
    "build-analyze": "vite build --mode analyze",
    "build-debug": "vite build -d",
    "build-profile": "vite build --profile --open",
    "start": "vite preview",
    "test:e2e": "playwright test",
    "pretest:e2e": "vite build",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "refine": "refine",
    "scan": "npx react-scan localhost:5173",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@playwright/test": "^1.64.0",
    "@redux-devtools/extension": "^3.3.0",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/cli": "^2.16.52",
    "@refinedev/core": "^5.0.12",
    "@refinedev/devtools": "^2.0.5",
    "@refinedev/react-router": "^2.0.4",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.90.10",
    "antd": "^5.29.3",
    "antd-style": "^3.7.1",
    "dayjs": "1.11.13",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.52.0",
    "i18next": "^25.10.10",
    "pinyin-pro": "^3.29.5",
    "pocketbase": "^0.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^16.6.6",
    "react-router": "^7.18.4",
    "tailwindcss": "4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@faker-js/faker": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tape": "^5.8.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "^5.0.5",
    "electron": "^44.7.2",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.154.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "refine": {
    "projectId": "1LFZhY-g5ZTkQ-8ndYcP"
  }
}
